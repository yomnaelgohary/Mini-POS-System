@{
    ViewBag.Title = "Create Sales Order";
}

<!-- Bootstrap & jQuery -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- Your custom JS -->
<script src="~/js/salesorder.js"></script>

<style>
    :root {
        --cashetrip-primary: #0f172a;
        --cashetrip-primary-light: #1e293b;
        --cashetrip-secondary: #334155;
        --cashetrip-accent: #475569;
        --cashetrip-light: #e2e8f0;
        --cashetrip-lighter: #f1f5f9;
    }

    body {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .page-header {
        background: linear-gradient(135deg, var(--cashetrip-primary) 0%, var(--cashetrip-secondary) 100%);
        color: white;
        padding: 2.5rem 0;
        margin: -1.5rem -15px 2.5rem -15px;
        border-radius: 0 0 25px 25px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.3);
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: 
            linear-gradient(45deg, rgba(255,255,255,0.02) 25%, transparent 25%),
            linear-gradient(-45deg, rgba(255,255,255,0.02) 25%, transparent 25%);
        background-size: 80px 80px;
    }

    .page-header .container {
        position: relative;
        z-index: 2;
    }

    .page-header h1 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

    .page-header h1 i {
        margin-right: 1rem;
        font-size: 2.5rem;
        opacity: 0.9;
    }

    .page-header p {
        font-size: 1.2rem;
        opacity: 0.9;
        margin: 0;
    }

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 2rem;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, var(--cashetrip-lighter) 0%, var(--cashetrip-light) 100%);
        border-bottom: 2px solid rgba(15, 23, 42, 0.1);
        border-radius: 20px 20px 0 0 !important;
        padding: 1.5rem 2rem;
    }

    .card-title {
        font-weight: 700;
        color: var(--cashetrip-primary);
        font-size: 1.3rem;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .card-title i {
        margin-right: 0.8rem;
        font-size: 1.4rem;
        opacity: 0.8;
    }

    .card-body {
        padding: 2rem;
    }

    .btn-icon {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.8rem 1.5rem;
        transition: all 0.3s ease;
        border: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--cashetrip-primary) 0%, var(--cashetrip-secondary) 100%);
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.3);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #020617 0%, var(--cashetrip-primary-light) 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.4);
    }

    .btn-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    .btn-danger:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
    }

    .btn-secondary {
        background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
        box-shadow: 0 4px 15px rgba(107, 114, 128, 0.3);
    }

    .btn-secondary:hover {
        background: linear-gradient(135deg, #4b5563 0%, #374151 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(107, 114, 128, 0.4);
    }

    .btn-outline-success {
        border: 2px solid #10b981;
        color: #10b981;
        background: transparent;
        font-weight: 600;
    }

    .btn-outline-success:hover {
        background: #10b981;
        border-color: #10b981;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
    }

    .form-control {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.8rem 1.2rem;
        transition: all 0.3s ease;
        background: #f8fafc;
        font-size: 1rem;
    }

    .form-control:focus {
        border-color: var(--cashetrip-secondary);
        box-shadow: 0 0 0 0.2rem rgba(51, 65, 85, 0.25);
        background: white;
    }

    .form-label {
        font-weight: 600;
        color: var(--cashetrip-primary);
        margin-bottom: 0.6rem;
        font-size: 0.95rem;
    }

    .alert-success-custom {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border: 2px solid #22c55e;
        color: #15803d;
        border-radius: 12px;
        padding: 1.2rem;
    }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border: 2px solid #f59e0b;
        color: #92400e;
        border-radius: 12px;
        padding: 1.2rem;
    }

    .table-container {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        background: white;
    }

    .table {
        margin-bottom: 0;
        border: none;
    }

    .table thead th {
        background: linear-gradient(135deg, var(--cashetrip-primary) 0%, var(--cashetrip-secondary) 100%);
        color: white;
        border: none;
        font-weight: 600;
        padding: 1.2rem 1rem;
        font-size: 0.95rem;
    }

    .table tbody td {
        padding: 1.2rem 1rem;
        border-color: #e2e8f0;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background-color: var(--cashetrip-lighter);
    }

    .grand-total-section {
        background: linear-gradient(135deg, var(--cashetrip-lighter) 0%, var(--cashetrip-light) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-top: 1.5rem;
        border: 2px solid rgba(15, 23, 42, 0.1);
    }

    .grand-total-section .display-6 {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--cashetrip-primary);
    }

    .modal-content {
        border: none;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .modal-header {
        border-radius: 20px 20px 0 0;
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #e2e8f0;
        background: linear-gradient(135deg, var(--cashetrip-lighter) 0%, var(--cashetrip-light) 100%);
    }

    .modal-title {
        font-weight: 700;
        font-size: 1.3rem;
        color: var(--cashetrip-primary);
    }

    .modal-body {
        padding: 2rem;
    }

    .search-result-card {
        background: linear-gradient(135deg, var(--cashetrip-lighter) 0%, #ffffff 100%);
        border: 2px solid var(--cashetrip-light);
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.3s ease;
    }

    .search-result-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--cashetrip-accent);
    }

    .empty-state i {
        font-size: 4rem;
        opacity: 0.5;
        margin-bottom: 1rem;
    }

    /* Action Buttons Section */
    .action-buttons {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        margin-top: 2rem;
    }

    .btn-lg {
        padding: 1rem 2.5rem;
        font-size: 1.1rem;
        border-radius: 15px;
    }

    
</style>

<div class="page-header">
    <div class="container">
        <h1>
            <i class="fas fa-plus-circle"></i>
            Create Sales Order
        </h1>
        <p>Create a new sales order by selecting customer and adding products</p>
    </div>
</div>

<div class="container mt-4">
    <!-- Step 1: Customer Section -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">
                <i class="fas fa-user-circle"></i>
                Customer Information
            </h5>
        </div>
        <div class="card-body">
            <!-- Customer Search Form -->
            <div class="row mb-3">
                <div class="col-md-5">
                    <label class="form-label">Customer Name</label>
                    <input type="text" id="searchName" class="form-control" placeholder="Enter customer name" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Customer Mobile</label>
                    <input type="text" id="searchMobile" class="form-control" placeholder="Enter mobile number" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary w-100 btn-icon" onclick="searchCustomer1()">
                        <i class="fas fa-search"></i>
                        Search
                    </button>
                </div>
            </div>
            <!-- Selected Customer Info (appears after selection) -->
            <div id="selectedCustomerInfo" class="alert alert-success-custom d-none mt-3">
                <div class="d-flex align-items-center">
                    <i class="fas fa-check-circle me-2"></i>
                    <div>
                        <div class="fw-bold">Selected Customer</div>
                        <div class="small mt-1">Customer information will appear here</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Results Modal (opens after clicking search) -->
    <div class="modal fade" id="searchCustomerModal" tabindex="-1" aria-labelledby="searchCustomerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title btn-icon" id="searchCustomerModalLabel">
                        <i class="fas fa-search"></i>
                        Customer Search Results
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Search Results Area -->
                    <div id="searchResultArea">
                        <div class="search-result-card mb-4">
                            <div id="searchResultMessage" class="mb-3">
                                <div class="alert alert-success-custom mb-3" style="display: none;" id="customerFoundAlert">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-check-circle me-2 mt-1"></i>
                                        <div>
                                            <div class="fw-bold">Customer Found!</div>
                                            <div class="mt-2 small">
                                                <p class="mb-1"><strong>Name:</strong> <span id="foundCustomerName"></span></p>
                                                <p class="mb-1"><strong>Mobile:</strong> <span id="foundCustomerMobile"></span></p>
                                                <p class="mb-0"><strong>Customer ID:</strong> <span id="foundCustomerId"></span></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="alert alert-warning-custom mb-3" style="display: none;" id="customerNotFoundAlert">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-exclamation-triangle me-2 mt-1"></i>
                                        <div>
                                            <div class="fw-bold">No Customer Found</div>
                                            <div class="mt-1 small">No customer matches your search criteria.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-success w-100 btn-icon d-none" id="selectCustomerBtn" onclick="selectCustomer()">
                                <i class="fas fa-user-check"></i>
                                Select This Customer
                            </button>
                        </div>
                    </div>
                    <hr class="my-4">
                    <div class="mb-4 d-none" id="addCustomerSection">
                        <h6 class="fw-bold btn-icon mb-3">
                            <i class="fas fa-user-plus"></i>
                            Add New Customer
                        </h6>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Customer Name</label>
                                <input type="text" id="newCustomerName" class="form-control" placeholder="Enter customer name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Mobile Number</label>
                                <input type="text" id="newCustomerMobile" class="form-control" placeholder="Enter mobile number" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-success w-100 btn-icon" onclick="addCustomer()">
                            <i class="fas fa-plus-circle"></i>
                            Add New Customer
                        </button>
                        <div id="addCustomerResult" class="alert d-none mt-3">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Product Search -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">
                <i class="fas fa-barcode"></i>
                Add Products
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-10">
                    <input type="text" id="searchProduct" class="form-control" placeholder="Enter Product ID or scan barcode" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100 btn-icon" onclick="searchProduct()">
                        <i class="fas fa-search"></i>
                        Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Order Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">
                <i class="fas fa-shopping-cart"></i>
                Order Summary
            </h5>
        </div>
        <div class="card-body">
            <div class="table-container">
                <table class="table table-hover mb-0" id="orderTable">
                    <thead>
                        <tr>
                            <th><i class="fas fa-tag me-2"></i>Description</th>
                            <th><i class="fas fa-barcode me-2"></i>Code</th>
                            <th><i class="fas fa-dollar-sign me-2"></i>Price</th>
                            <th><i class="fas fa-sort-numeric-up me-2"></i>Quantity</th>
                            <th><i class="fas fa-calculator me-2"></i>Total</th>
                            <th class="text-center"><i class="fas fa-cogs me-2"></i>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Default empty state -->
                        <tr id="emptyOrderRow">
                            <td colspan="6" class="empty-state">
                                <i class="fas fa-shopping-cart"></i>
                                <div class="fw-bold">No products added yet</div>
                                <div class="small">Search and add products to create your order</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="grand-total-section text-end">
                <div class="display-6">
                    <i class="fas fa-receipt me-2"></i>
                    Grand Total:
                    <span id="orderTotal" class="text-success">0</span>
                    <span class="text-success">EGP</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 4: Submit Buttons -->
    <div class="action-buttons text-center">
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button class="btn btn-success btn-lg btn-icon" onclick="submitOrder()">
                <i class="fas fa-check-circle"></i>
                Submit Order
            </button>
            <button class="btn btn-danger btn-lg btn-icon" onclick="resetOrder()">
                <i class="fas fa-trash"></i>
                Cancel Order
            </button>
            <a href="/SalesOrder/AllOrders" class="btn btn-secondary btn-lg btn-icon">
                <i class="fas fa-list"></i>
                View All Orders
            </a>
        </div>
    </div>
</div>

<!-- Product Modal -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-icon">
                    <i class="fas fa-box"></i>
                    Product Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Description:</label>
                        <p id="modalProductName" class="mb-0 fw-semibold">Product name will appear here</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Code:</label>
                        <p id="modalProductCode" class="mb-0 fw-semibold">Product code will appear here</p>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Price:</label>
                    <p id="modalProductPrice" class="fs-4 fw-bold text-success mb-0">0 EGP</p>
                </div>
                <div class="mb-4">
                    <label for="modalProductQty" class="form-label">Quantity:</label>
                    <input type="number" id="modalProductQty" class="form-control" />
                </div>
                <button class="btn btn-success w-100 btn-icon" onclick="addProductToOrder($('#modalProductQty').val())">
                    <i class="fas fa-plus-circle"></i>
                    Add to Order
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Order Success Modal -->
<div class="modal fade" id="orderSuccessModal" tabindex="-1" aria-labelledby="orderSuccessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="orderSuccessModalLabel">
                    <i class="fas fa-check-circle me-2"></i>
                    Order Submitted
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-check-circle text-success" style="font-size: 4rem; margin-bottom: 1rem;"></i>
                <h4 class="fw-bold text-success mb-3">Success!</h4>
                <p class="mb-0">The order was successfully created and saved!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-icon" data-bs-dismiss="modal">
                    <i class="fas fa-thumbs-up me-2"></i>
                    OK
                </button>
            </div>
        </div>
    </div>
</div>